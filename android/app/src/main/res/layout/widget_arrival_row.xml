<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/row_bar"
        android:layout_width="4dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_line_bar" />

    <TextView
        android:id="@+id/row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />

    <Chronometer
        android:id="@+id/row_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:countDown="true"
        android:fontFeatureSettings="tnum"
        android:minWidth="48dp"
        android:gravity="end"
        android:textColor="@color/widget_accent"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
